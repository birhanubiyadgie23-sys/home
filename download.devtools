      </div>

      <!-- Right Column - World animation slide in right -->
      <div class="col-lg-7 slide-in-right delay-1">
        <a href="/?locale=en">
          <div class="parallax ratio ratio-1x1 mx-auto" style="max-width: 550px; transform: translate3d(0px, 0px, 0px) rotate(0.0001deg); transform-style: preserve-3d; backface-visibility: hidden; pointer-events: none;">

            <!-- World spin -->
            <div class="parallax-layer position-absolute zindex-2" data-depth="-0.15" style="transform: translate3d(1.3px, 0.4px, 0px);">
              <img class="hero-animation-spin p-md-0 p-5" src="/assets/world-dc69f73ddcf3e0d838d6e97f7ec637571f2104e506cb2ed0a46da71a797d95cc.png" />
            </div>

            <!-- Outer circles -->
            <div class="parallax-layer d-flex justify-content-center align-items-center position-absolute top-0 start-0 w-100 h-100" data-depth="0.1">
              <div class="rounded-circle bg-primary" style="width: 70%; height: 70%; opacity: .16;"></div>
            </div>

            <div class="parallax-layer d-flex justify-content-center align-items-center position-absolute top-0 start-0 w-100 h-100" data-depth="0.2">
              <div class="rounded-circle bg-primary" style="width: 55%; height: 55%; opacity: .26;"></div>
            </div>

            <!-- Center Mesob Logo -->
            <div class="parallax-layer d-flex justify-content-center align-items-center position-absolute top-0 start-0 w-100 h-100 zindex-3" data-depth="0.4">
              <div class="d-flex justify-content-center align-items-center rounded-circle bg-primary" style="width: 93px; height: 93px; box-shadow: 0 .1875rem 1.875rem -.125rem rgba(93,137,189,.95);">
                <span class="text-light mb-0">
                  <center></center>
                </span>
