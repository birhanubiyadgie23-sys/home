      <section class="position-relative py-5" style="background-image: url('https://ict.moh.gov.et/assets/pattern-1bad8bc852e9ddf5cdade58bc1fd7e01094f7cef4ce11d468316a18dd128e9a5.svg'); background-repeat: repeat-x; background-position: top; background-size: auto 100px;">
